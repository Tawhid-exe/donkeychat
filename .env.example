# ── Signaling backend (primary) ──
# Supabase project URL + anon key. When unreachable (e.g. paused free-tier
# project), DonkeyChat automatically falls back to the backup relay below.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Backup relay server (fallback) ──
# Deploy /server to Render via render.yaml, then point this at its /ws endpoint.
# Used automatically when Supabase is unreachable; also powers Tier 3/4
# chunk storage whenever Supabase Storage isn't available.
# VITE_RELAY_WS_URL=wss://donkeychat-relay.onrender.com/ws

# Optional shared secret matching RELAY_TOKEN on the relay server.
# VITE_RELAY_TOKEN=

# ── Optional: dedicated HTTP chunk-store base (defaults to the origin of
# VITE_RELAY_WS_URL when unset) ──
# VITE_RELAY_URL=https://donkeychat-relay.onrender.com

# ── Optional: TURN relay for strict NATs (Metered.ca) ──
# VITE_METERED_API_KEY=your-metered-key
